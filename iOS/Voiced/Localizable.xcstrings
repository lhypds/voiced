    "识别过程中点击始终复制。播放时再次点击任意条目停止。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Erkennung wird beim Antippen kopiert. Während der Wiedergabe stoppt ein Tippen auf einen Eintrag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapping during recognition always copies. During playback, tap any entry to stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante el reconocimiento, tocar siempre copia. Durante la reproducción, toca cualquier entrada para detener."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant la reconnaissance, toucher copie toujours. Pendant la lecture, touchez une ligne pour arrêter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認識中のタップは常にコピーです。再生中は任意の行をタップすると停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别过程中点击始终复制。播放时再次点击任意条目停止。"
