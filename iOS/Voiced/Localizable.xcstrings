    "优先匹配指定语言，再匹配任意语言规则。相同来源的首条规则生效。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestimmte Sprachen haben Vorrang. Es gilt die erste Regel pro Ausgangssprache."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Specific language rules take priority over any-language rules. The first rule for each source applies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los idiomas específicos tienen prioridad. Se aplica la primera regla de cada origen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les langues précises sont prioritaires. La première règle de chaque source s’applique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定言語のルールを優先し、次にすべての言語のルールを適用します。同じ元言語の先頭のルールが有効です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先匹配指定语言，再匹配任意语言规则。相同来源的首条规则生效。"
          }
        }
      }
    },
    "优先匹配指定语言，再匹配任意语言规则。相同来源的首条规则生效。左滑可删除规则。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestimmte Sprachen haben Vorrang. Es gilt die erste Regel pro Ausgangssprache. Zum Löschen nach links wischen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Specific languages take priority over any-language rules. The first rule for each source applies. Swipe left to delete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los idiomas específicos tienen prioridad. Se aplica la primera regla de cada origen. Desliza a la izquierda para eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les langues précises sont prioritaires. La première règle de chaque source s’applique. Balayez à gauche pour supprimer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定言語のルールを優先し、次にすべての言語のルールを適用します。同じ元言語の先頭のルールが有効です。左にスワイプして削除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先匹配指定语言，再匹配任意语言规则。相同来源的首条规则生效。左滑可删除规则。"
          }
        }
      }
    },
    "低于此音量的声音不会触发识别。声音较轻或距离较远时可适当调低。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leiserer Ton löst keine Erkennung aus. Bei leisen oder entfernten Stimmen den Wert senken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio below this level will not trigger recognition. Lower it for quiet or distant speech."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio por debajo de este nivel no activa el reconocimiento. Bájalo para voces bajas o lejanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un son inférieur à ce niveau ne déclenche pas la reconnaissance. Réduisez-le pour les voix faibles ou éloignées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この音量未満では認識されません。声が小さい、または遠い場合は下げてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于此音量的声音不会触发识别。声音较轻或距离较远时可适当调低。"
          }
        }
      }
    },
    "使用与 Mac 相同的 Silero VAD 模型过滤音乐等非人声。首次开启需下载约 1 MB 模型。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet wie die Mac-App Silero VAD zum Filtern von Musik und anderen Geräuschen. Erster Download etwa 1 MB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the same Silero VAD model as the Mac app to filter music and other non-speech audio. First use downloads about 1 MB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el mismo modelo Silero VAD que la app de Mac para filtrar música y otros sonidos. Descarga inicial de unos 1 MB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le même modèle Silero VAD que sur Mac pour filtrer la musique et les sons non vocaux. Environ 1 Mo à télécharger."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 版と同じ Silero VAD で音楽などの非音声を除外します。初回は約 1 MB のモデルをダウンロードします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用与 Mac 相同的 Silero VAD 模型过滤音乐等非人声。首次开启需下载约 1 MB 模型。"
          }
        }
      }
    },
    "使用当前设置试听，不写入正文、历史或录音文件，也不发送 AI 请求。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Einstellungen testen, ohne Transkript, Verlauf oder Audio zu speichern und ohne KI-Anfragen zu senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try recognition with your current settings. Nothing is saved to the transcript, history or audio files, and no AI requests are sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba los ajustes actuales sin guardar transcripciones, historial ni audio, y sin enviar solicitudes de IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez les réglages actuels sans rien enregistrer dans la transcription, l’historique ou les fichiers audio, ni envoyer de requête IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の設定で認識を試します。本文、履歴、録音ファイルには保存せず、AI にも送信しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用当前设置试听，不写入正文、历史或录音文件，也不发送 AI 请求。"
          }
        }
      }
    },
    "使用系统提供的麦克风或外接输入。来电或进入后台时会结束录音，已采集音频会保存。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt Systemmikrofon oder externen Eingang. Bei Anrufen oder im Hintergrund endet die Aufnahme; erfasster Ton wird gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses a system microphone or external input. Calls or entering the background end recording; captured audio is saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el micrófono del sistema o una entrada externa. Las llamadas o el paso a segundo plano detienen la grabación y guardan el audio capturado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le micro système ou une entrée externe. Les appels ou le passage en arrière-plan arrêtent l’enregistrement ; l’audio capturé est conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのマイクまたは外部入力を使います。着信時やバックグラウンド移行時は録音を終了し、収録済みの音声を保存します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用系统提供的麦克风或外接输入。来电或进入后台时会结束录音，已采集音频会保存。"
          }
        }
      }
    },
