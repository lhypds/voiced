    "重置偏好和 API 密钥，不删除历史记录、录音或已下载模型。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt Einstellungen und API-Schlüssel zurück. Verlauf, Aufnahmen und Modelle bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resets preferences and the API key. Keeps history, recordings and downloaded models."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece preferencias y clave API. Conserva historial, grabaciones y modelos descargados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialise les préférences et la clé API. Conserve l’historique, les enregistrements et les modèles téléchargés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定と API キーをリセットします。履歴、録音、ダウンロード済みモデルは残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置偏好和 API 密钥，不删除历史记录、录音或已下载模型。"
          }
        }
      }
