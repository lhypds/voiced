#!/bin/zsh
#
# vd：控制 Voiced Input 服务（launchd 用户代理），加 ui 时同时控制 Voiced 界面。
# 在仓库根目录直接运行 ./vd，或用 ./install.sh 安装为系统命令 vd（./uninstall.sh 删除）。
#
#   vd start          启动服务，并在每次登录时自动启动
#   vd stop           停止服务，登录时不再启动
#   vd restart        重启服务
#   vd start ui       启动服务和 Voiced 界面
#   vd stop ui        停止 Voiced 界面和服务
#   vd restart ui     重启两者
#   vd status         显示两者的状态
#
# 服务运行时菜单栏右上角有一个图标，点击可查看状态或停止服务。

set -euo pipefail

# :A resolves the /usr/local/bin/vd symlink, so paths point into the checkout.
ROOT="${0:A:h}"
CORE="$ROOT/core"

LABEL="com.local.voiced.input"
DOMAIN="gui/$(id -u)"
SERVICE_EXECUTABLE="$CORE/.build/vd"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HOME/Library/Logs/VoicedInput.log"

UI_APP="$ROOT/.build/Voiced.app"
UI_EXECUTABLE="$UI_APP/Contents/MacOS/Voiced"

usage() {
    print -u2 "Usage: vd start|stop|restart [ui]"
    print -u2 "       vd status"
    exit 2
}

# MARK: Service

service_loaded() {
    launchctl print "$DOMAIN/$LABEL" &>/dev/null
}

service_pid() {
    launchctl print "$DOMAIN/$LABEL" 2>/dev/null | awk '$1 == "pid" { print $3; exit }'
}

write_plist() {
    mkdir -p "${PLIST:h}" "${LOG:h}"
    cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$SERVICE_EXECUTABLE</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>$LOG</string>
    <key>StandardErrorPath</key>
    <string>$LOG</string>
</dict>
</plist>
PLIST
}

start_service() {
    if service_loaded; then
        print "Voiced Input is already running."
        return 0
    fi
    [[ -x "$SERVICE_EXECUTABLE" ]] || "$CORE/build.sh"
    write_plist
    # Right after a bootout launchd may still be tearing the job down and refuse the bootstrap
    # with an I/O error for a moment.
    local i
    for i in {1..20}; do
        launchctl bootstrap "$DOMAIN" "$PLIST" 2>/dev/null && break
        sleep 0.25
    done
    if ! service_loaded; then
        print -u2 "Voiced Input did not start; see $LOG"
        return 1
    fi
    print "Started Voiced Input."
}

stop_service() {
    # Removing the plist keeps the service from starting again at the next login.
    rm -f "$PLIST"
    if ! service_loaded; then
        print "Voiced Input is not running."
        return 0
    fi
    launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
    # launchd keeps listing the job for a moment after bootout returns; wait, so a following
    # start loads it again instead of finding it still there.
    local i
    for i in {1..50}; do
        service_loaded || break
        sleep 0.1
    done
    if service_loaded; then
        print -u2 "Voiced Input did not stop."
        return 1
    fi
    print "Stopped Voiced Input."
}

# MARK: Interface

ui_running() {
    pgrep -f -- "$UI_EXECUTABLE" >/dev/null
}

start_ui() {
    if ui_running; then
        # open brings the running app to the front.
        open "$UI_APP"
        print "Voiced is already running."
        return 0
    fi
    [[ -x "$UI_EXECUTABLE" ]] || "$ROOT/Scripts/build-app.sh"
    open "$UI_APP"
    print "Started Voiced."
}

stop_ui() {
    if ! ui_running; then
        print "Voiced is not running."
        return 0
    fi
    pkill -f -- "$UI_EXECUTABLE"
    # Wait for the process to exit: open run against an app that is still quitting fails with
    # LaunchServices error -600, so restart would leave Voiced stopped.
    local i
    for i in {1..50}; do
        ui_running || break
        sleep 0.1
    done
    if ui_running; then
        print -u2 "Voiced did not stop."
        return 1
    fi
    print "Stopped Voiced."
}

# MARK: Status

show_status() {
    if service_loaded; then
        local pid="$(service_pid)"
        if [[ -n "$pid" ]]; then
            print "Voiced Input: running (pid $pid)"
        else
            print "Voiced Input: starting (launchd will retry; see $LOG)"
        fi
    else
        print "Voiced Input: stopped"
    fi
    if ui_running; then
        print "Voiced:       running"
    else
        print "Voiced:       stopped"
    fi
}

# MARK: Commands

(( $# >= 1 && $# <= 2 )) || usage
action="$1"
target="${2:-}"
[[ -z "$target" || "$target" == "ui" ]] || usage

case "$action" in
    start)
        start_service
        [[ -z "$target" ]] || start_ui
        ;;
    stop)
        [[ -z "$target" ]] || stop_ui
        stop_service
        ;;
    restart)
        [[ -z "$target" ]] || stop_ui
        stop_service
        start_service
        [[ -z "$target" ]] || start_ui
        ;;
    status)
        [[ -z "$target" ]] || usage
        show_status
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage
        ;;
esac
