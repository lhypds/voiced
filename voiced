#!/bin/zsh
#
# voiced：运行 voiced 服务（launchd 用户代理），并启动 Voiced 应用。
# 在仓库根目录直接运行 ./voiced，或用 ./install.sh 安装为系统命令 voiced（./uninstall.sh 删除）。
#
#   voiced                启动服务，并在每次登录时自动启动（文件夹为主目录）
#   voiced .              启动服务，文件夹设为当前文件夹（AI 目标在此文件夹中运行）
#   voiced ~/abc          启动服务，文件夹设为该路径
#   voiced start          询问在 macOS 还是 iOS 上启动 Voiced
#   voiced start macos    打开 Mac 版（需要时先构建）
#   voiced start ios      从已连接的 iPhone 和模拟器中选择，构建、安装并打开
#   voiced start ios device  直接构建、安装并打开到已配对的 iPhone，不显示列表
#   voiced stop           停止服务，登录时不再启动
#   voiced stop macos     退出 Mac 版
#   voiced restart        重启服务（可加文件夹）；voiced restart macos 重启 Mac 版
#   voiced restart ios [device]  重新构建、安装并重新打开 iOS 版（device：已配对的 iPhone）
#   voiced status         显示服务和 Mac 版的状态
#   voiced help           显示帮助
#
# 服务运行时菜单栏右上角有一个图标，点击可查看状态、设置 Claude Code 的文件夹或停止服务。
# 每句话如何处理（输入、输入后回车、用 Claude Code 执行）由 iPhone 上的“发送到 Mac”方式决定。

set -euo pipefail

# :A resolves the /usr/local/bin/voiced symlink, so paths point into the checkout.
ROOT="${0:A:h}"
CORE="$ROOT/core"

LABEL="com.local.voiced.input"
DOMAIN="gui/$(id -u)"
SERVICE_EXECUTABLE="$CORE/.build/voiced"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HOME/Library/Logs/VoicedInput.log"

UI_APP="$ROOT/macos/.build/Voiced.app"
UI_EXECUTABLE="$UI_APP/Contents/MacOS/Voiced"

usage() {
    print -u2 "Usage: voiced [folder]"
    print -u2 "       voiced start [macos|ios [device]]"
    print -u2 "       voiced stop [macos]"
    print -u2 "       voiced restart [macos|ios [device]|folder]"
    print -u2 "       voiced status"
    print -u2 "       voiced help"
    exit 2
}

show_help() {
    cat <<'HELP'
voiced runs the voiced service, which types what Voiced on the iPhone hears at the Mac's
cursor, and starts the Voiced apps.

  voiced                       start the service, and at every login
  voiced <folder>              the same, with Claude Code running in that folder
                               (voiced . for the current folder; without one, the home folder)
  voiced start                 ask whether to start Voiced on macOS or iOS
  voiced start macos           open the Mac app, building it first if needed
  voiced start ios             pick a connected iPhone or a simulator, then build, install and
                               open the app there
  voiced start ios device      the same on the paired iPhone, without the list
  voiced stop                  stop the service; it no longer starts at login
  voiced stop macos            quit the Mac app
  voiced restart [folder]      restart the service
  voiced restart macos         restart the Mac app
  voiced restart ios [device]  rebuild, reinstall and reopen the iOS app (device: the paired iPhone)
  voiced status                show the service, the Mac app and the folder

What happens to each sentence (typed at the cursor, typed and followed by Return, or run
by Claude Code) is the "Send to Mac" mode chosen on the iPhone.
HELP
}

# MARK: Settings (the service's defaults domain; it reads them for every sentence)

set_work_folder() {
    defaults write "$LABEL" workFolder -string "$1"
}

current_work_folder() {
    defaults read "$LABEL" workFolder 2>/dev/null || print "$HOME"
}

# MARK: Service

service_loaded() {
    launchctl print "$DOMAIN/$LABEL" &>/dev/null
}

service_pid() {
    launchctl print "$DOMAIN/$LABEL" 2>/dev/null | awk '$1 == "pid" { print $3; exit }'
}

write_plist() {
    mkdir -p "${PLIST:h}" "${LOG:h}"
    cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$SERVICE_EXECUTABLE</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>$LOG</string>
    <key>StandardErrorPath</key>
    <string>$LOG</string>
</dict>
</plist>
PLIST
}

start_service() {
    if service_loaded; then
        print "voiced is already running."
        return 0
    fi
    [[ -x "$SERVICE_EXECUTABLE" ]] || "$CORE/build.sh"
    write_plist
    # Right after a bootout launchd may still be tearing the job down and refuse the bootstrap
    # with an I/O error for a moment.
    local i
    for i in {1..20}; do
        launchctl bootstrap "$DOMAIN" "$PLIST" 2>/dev/null && break
        sleep 0.25
    done
    if ! service_loaded; then
        print -u2 "voiced did not start; see $LOG"
        return 1
    fi
    print "Started voiced."
}

stop_service() {
    # Removing the plist keeps the service from starting again at the next login.
    rm -f "$PLIST"
    if ! service_loaded; then
        print "voiced is not running."
        return 0
    fi
    launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
    # launchd keeps listing the job for a moment after bootout returns; wait, so a following
    # start loads it again instead of finding it still there.
    local i
    for i in {1..50}; do
        service_loaded || break
        sleep 0.1
    done
    if service_loaded; then
        print -u2 "voiced did not stop."
        return 1
    fi
    print "Stopped voiced."
}

# MARK: Interface

ui_running() {
    pgrep -f -- "$UI_EXECUTABLE" >/dev/null
}

start_ui() {
    if ui_running; then
        # open brings the running app to the front.
        open "$UI_APP"
        print "Voiced is already running."
        return 0
    fi
    [[ -x "$UI_EXECUTABLE" ]] || "$ROOT/macos/Scripts/build-app.sh"
    open "$UI_APP"
    print "Started Voiced."
}

stop_ui() {
    if ! ui_running; then
        print "Voiced is not running."
        return 0
    fi
    pkill -f -- "$UI_EXECUTABLE"
    # Wait for the process to exit: open run against an app that is still quitting fails with
    # LaunchServices error -600, so restart would leave Voiced stopped.
    local i
    for i in {1..50}; do
        ui_running || break
        sleep 0.1
    done
    if ui_running; then
        print -u2 "Voiced did not stop."
        return 1
    fi
    print "Stopped Voiced."
}

# MARK: iOS

# Prints "<kind>\t<id>\t<label>" for each paired iPhone or iPad (kind device) and each iOS
# simulator worth offering (kind simulator): every booted one, and the iPhones and iPads of the
# newest runtime.
ios_targets() {
    local json="$(mktemp -t voiced-devices)"
    xcrun devicectl list devices --json-output "$json" >/dev/null 2>&1 || true
    xcrun simctl list devices available --json 2>/dev/null | /usr/bin/python3 -c '
import json, re, sys

try:
    devices = json.load(open(sys.argv[1]))["result"]["devices"]
except Exception:
    devices = []
for d in devices:
    hardware = d.get("hardwareProperties", {})
    connection = d.get("connectionProperties", {})
    if hardware.get("deviceType") not in ("iPhone", "iPad") or connection.get("pairingState") != "paired":
        continue
    state = "connected" if connection.get("tunnelState") != "unavailable" and connection.get("tunnelState") != "disconnected" else "not connected"
    # zsh garbles some UTF-8 bytes when it prints a select menu, among them the second byte of
    # the curly apostrophe in the default "Name’s iPhone"; show a plain one.
    name = d.get("deviceProperties", {}).get("name", d["identifier"]).replace("\u2019", "\x27")
    print("device", d["identifier"], f"{name} ({state})", sep="\t")

def version(runtime):
    m = re.search(r"iOS-(\d+)-(\d+)", runtime)
    return (int(m.group(1)), int(m.group(2))) if m else None

runtimes = {version(r): v for r, v in json.load(sys.stdin)["devices"].items() if version(r)}
newest = max(runtimes) if runtimes else None
for v in sorted(runtimes, reverse=True):
    for d in runtimes[v]:
        booted = d["state"] == "Booted"
        if booted or (v == newest and d["name"].startswith(("iPhone", "iPad"))):
            note = ", booted" if booted else ""
            name = d["name"]
            print("simulator", d["udid"], f"{name} simulator (iOS {v[0]}.{v[1]}{note})", sep="\t")
' "$json"
    rm -f "$json"
}

# Asks which device or simulator to use, then builds, installs and starts the app there.
start_ios() {
    local -a kinds ids labels
    local kind id label
    while IFS=$'\t' read -r kind id label; do
        kinds+=("$kind"); ids+=("$id"); labels+=("$label")
    done < <(ios_targets)
    if (( ${#labels} == 0 )); then
        print -u2 "No iPhone or simulator found. Connect an iPhone, or install a simulator in Xcode."
        return 1
    fi

    local PROMPT3="Run Voiced on: " choice
    select choice in "${labels[@]}"; do
        [[ -n "$choice" ]] && break
    done
    [[ -n "$choice" ]] || return 1
    local i="${labels[(ie)$choice]}"

    if [[ "${kinds[$i]}" == device ]]; then
        "$ROOT/ios/deploy.sh" "${ids[$i]}"
    else
        "$ROOT/ios/emulate.sh" "${ids[$i]}"
    fi
}

# Asks for the platform when none is given, and sets platform. It runs in this shell, not in
# $(...), so the device menu that may follow reads the next line of input.
choose_platform() {
    local PROMPT3="Start Voiced on: " choice
    select choice in macos ios; do
        [[ -n "$choice" ]] && { platform="$choice"; return 0; }
    done
    return 1
}

# MARK: Status

show_status() {
    if service_loaded; then
        local pid="$(service_pid)"
        if [[ -n "$pid" ]]; then
            print "voiced:       running (pid $pid)"
        else
            print "voiced:       starting (launchd will retry; see $LOG)"
        fi
    else
        print "voiced:       stopped"
    fi
    if ui_running; then
        print "Voiced app:   running"
    else
        print "Voiced app:   stopped"
    fi
    print "Folder:       $(current_work_folder)"
}

# MARK: Commands

# Exits when the argument is not a folder. Called directly, not inside $(...), so the exit
# ends the script.
require_folder() {
    if [[ ! -d "$1" ]]; then
        print -u2 "voiced: $1 is not a folder"
        exit 2
    fi
}

# Starts the service with the given folder, or the home folder.
start_service_in() {
    local folder="${1:-$HOME}"
    set_work_folder "$folder"
    start_service
    print "Folder: $folder"
}

case "${1:-}" in
    "")
        start_service_in
        ;;
    help|-h|--help)
        show_help
        ;;
    start)
        (( $# <= 3 )) || usage
        platform="${2:-}"
        [[ -n "$platform" ]] || choose_platform || exit 1
        case "$platform:${3:-}" in
            macos:) start_ui ;;
            ios:) start_ios ;;
            # The first paired iPhone, without the list.
            ios:device) "$ROOT/ios/deploy.sh" ;;
            *) usage ;;
        esac
        ;;
    stop)
        (( $# <= 2 )) || usage
        case "${2:-}" in
            "") stop_service ;;
            macos) stop_ui ;;
            *) usage ;;
        esac
        ;;
    restart)
        (( $# <= 3 )) || usage
        case "${2:-}:${3:-}" in
            macos:)
                stop_ui
                start_ui
                ;;
            # Rebuild, reinstall and relaunch: the deploy and emulate scripts end the running app first.
            ios:) start_ios ;;
            ios:device) "$ROOT/ios/deploy.sh" ;;
            ios:*) usage ;;
            *:?*) usage ;;
            *)
                folder=""
                if [[ -n "${2:-}" ]]; then
                    require_folder "$2"
                    folder="${2:A}"
                fi
                stop_service
                start_service_in "$folder"
                ;;
        esac
        ;;
    status)
        (( $# == 1 )) || usage
        show_status
        ;;
    *)
        # voiced <folder>: start the service with that folder.
        (( $# == 1 )) || usage
        require_folder "$1"
        start_service_in "${1:A}"
        ;;
esac
