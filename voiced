#!/bin/zsh
#
# voiced：打开 Voiced 界面，控制 Voiced Input 服务（launchd 用户代理），加 ui 时同时控制界面。
# 在仓库根目录直接运行 ./voiced，或用 ./install.sh 安装为系统命令 voiced（./uninstall.sh 删除）。
#
#   voiced                打开 Voiced 界面（需要时先构建）
#   voiced start          启动服务，并在每次登录时自动启动
#   voiced stop           停止服务，登录时不再启动
#   voiced restart        重启服务
#   voiced start ui       启动服务和 Voiced 界面
#   voiced stop ui        停止 Voiced 界面和服务
#   voiced restart ui     重启两者
#   voiced status         显示两者的状态
#
#   voiced start .        在当前文件夹启动（AI 目标在此文件夹中运行）；不带文件夹时使用主目录
#   voiced target         显示目标；voiced target cursor | claude | codex 设置目标：
#                         cursor 输入到当前光标处，claude / codex 在终端中打开 Claude Code / Codex 并发送每句话
#
# 服务运行时菜单栏右上角有一个图标，点击可查看状态或停止服务。

set -euo pipefail

# :A resolves the /usr/local/bin/voiced symlink, so paths point into the checkout.
ROOT="${0:A:h}"
CORE="$ROOT/core"

LABEL="com.local.voiced.input"
DOMAIN="gui/$(id -u)"
SERVICE_EXECUTABLE="$CORE/.build/voiced"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HOME/Library/Logs/VoicedInput.log"

UI_APP="$ROOT/macos/.build/Voiced.app"
UI_EXECUTABLE="$UI_APP/Contents/MacOS/Voiced"

usage() {
    print -u2 "Usage: voiced                      open the Voiced window"
    print -u2 "       voiced start|restart [ui] [folder]"
    print -u2 "       voiced stop [ui]"
    print -u2 "       voiced target [cursor|claude|codex]"
    print -u2 "       voiced status"
    exit 2
}

# MARK: Settings (the service's defaults domain; it reads them for every sentence)

set_work_folder() {
    defaults write "$LABEL" workFolder -string "$1"
}

current_target() {
    defaults read "$LABEL" target 2>/dev/null || print cursor
}

current_work_folder() {
    defaults read "$LABEL" workFolder 2>/dev/null || print "$HOME"
}

target_title() {
    case "$1" in
        claude) print "Claude Code" ;;
        codex) print "Codex" ;;
        *) print "Cursor" ;;
    esac
}

# MARK: Service

service_loaded() {
    launchctl print "$DOMAIN/$LABEL" &>/dev/null
}

service_pid() {
    launchctl print "$DOMAIN/$LABEL" 2>/dev/null | awk '$1 == "pid" { print $3; exit }'
}

write_plist() {
    mkdir -p "${PLIST:h}" "${LOG:h}"
    cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$SERVICE_EXECUTABLE</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>$LOG</string>
    <key>StandardErrorPath</key>
    <string>$LOG</string>
</dict>
</plist>
PLIST
}

start_service() {
    if service_loaded; then
        print "Voiced Input is already running."
        return 0
    fi
    [[ -x "$SERVICE_EXECUTABLE" ]] || "$CORE/build.sh"
    write_plist
    # Right after a bootout launchd may still be tearing the job down and refuse the bootstrap
    # with an I/O error for a moment.
    local i
    for i in {1..20}; do
        launchctl bootstrap "$DOMAIN" "$PLIST" 2>/dev/null && break
        sleep 0.25
    done
    if ! service_loaded; then
        print -u2 "Voiced Input did not start; see $LOG"
        return 1
    fi
    print "Started Voiced Input."
}

stop_service() {
    # Removing the plist keeps the service from starting again at the next login.
    rm -f "$PLIST"
    if ! service_loaded; then
        print "Voiced Input is not running."
        return 0
    fi
    launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
    # launchd keeps listing the job for a moment after bootout returns; wait, so a following
    # start loads it again instead of finding it still there.
    local i
    for i in {1..50}; do
        service_loaded || break
        sleep 0.1
    done
    if service_loaded; then
        print -u2 "Voiced Input did not stop."
        return 1
    fi
    print "Stopped Voiced Input."
}

# MARK: Interface

ui_running() {
    pgrep -f -- "$UI_EXECUTABLE" >/dev/null
}

start_ui() {
    if ui_running; then
        # open brings the running app to the front.
        open "$UI_APP"
        print "Voiced is already running."
        return 0
    fi
    [[ -x "$UI_EXECUTABLE" ]] || "$ROOT/macos/Scripts/build-app.sh"
    open "$UI_APP"
    print "Started Voiced."
}

stop_ui() {
    if ! ui_running; then
        print "Voiced is not running."
        return 0
    fi
    pkill -f -- "$UI_EXECUTABLE"
    # Wait for the process to exit: open run against an app that is still quitting fails with
    # LaunchServices error -600, so restart would leave Voiced stopped.
    local i
    for i in {1..50}; do
        ui_running || break
        sleep 0.1
    done
    if ui_running; then
        print -u2 "Voiced did not stop."
        return 1
    fi
    print "Stopped Voiced."
}

# MARK: Status

show_status() {
    if service_loaded; then
        local pid="$(service_pid)"
        if [[ -n "$pid" ]]; then
            print "Voiced Input: running (pid $pid)"
        else
            print "Voiced Input: starting (launchd will retry; see $LOG)"
        fi
    else
        print "Voiced Input: stopped"
    fi
    if ui_running; then
        print "Voiced:       running"
    else
        print "Voiced:       stopped"
    fi
    print "Target:       $(target_title "$(current_target)")"
    print "Folder:       $(current_work_folder)"
}

# MARK: Commands

# With no argument, open the window, as the voiced command always has.
if (( $# == 0 )); then
    start_ui
    exit
fi
action="$1"
shift

# start and restart take "ui" and a folder, in either order; stop takes "ui".
with_ui=0
folder=""
if [[ "$action" == (start|stop|restart) ]]; then
    for argument in "$@"; do
        if [[ "$argument" == "ui" ]]; then
            with_ui=1
        elif [[ "$action" != stop && -z "$folder" ]]; then
            if [[ ! -d "$argument" ]]; then
                print -u2 "voiced: $argument is not a folder"
                exit 2
            fi
            folder="${argument:A}"
        else
            usage
        fi
    done
fi

case "$action" in
    start)
        set_work_folder "${folder:-$HOME}"
        start_service
        (( ! with_ui )) || start_ui
        print "Folder: ${folder:-$HOME}"
        ;;
    stop)
        (( ! with_ui )) || stop_ui
        stop_service
        ;;
    restart)
        set_work_folder "${folder:-$HOME}"
        (( ! with_ui )) || stop_ui
        stop_service
        start_service
        (( ! with_ui )) || start_ui
        print "Folder: ${folder:-$HOME}"
        ;;
    target)
        (( $# <= 1 )) || usage
        if (( $# == 0 )); then
            print "$(target_title "$(current_target)")"
        else
            case "$1" in
                cursor|claude|codex) defaults write "$LABEL" target -string "$1" ;;
                *) usage ;;
            esac
            print "Target: $(target_title "$1")"
        fi
        ;;
    status)
        (( $# == 0 )) || usage
        show_status
        ;;
    *)
        usage
        ;;
esac
