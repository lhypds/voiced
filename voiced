}

# MARK: Menu

# choose <title> <option>...: lets the user pick an option with the arrow keys (or j and k, or
# its number) and Return, and sets choice. q or Escape cancels, and choose fails.
choose() {
    local title="$1"
    shift
    local -a options=("$@")
    local count=${#options} index=1 picked=0 drawn=0 key rest i
    if [[ ! -t 0 || ! -t 2 ]]; then
        print -u2 "voiced: $title give one on the command line: ${(j:, :)options}"
        return 1
    fi
    print -u2 -- $'\e[1m'"$title"$'\e[0m'
    while true; do
        (( drawn )) && print -nu2 -- $'\e['"${count}A"
        for i in {1..$count}; do
            if (( i == index )); then
                print -u2 -- $'\e[2K\e[36m❯ '"${options[i]}"$'\e[0m'
            else
                print -u2 -- $'\e[2K  '"${options[i]}"
            fi
        done
        drawn=1
        (( picked )) && break
        read -rsk1 key || return 1
        case "$key" in
            $'\e')
                rest=""
                read -rsk2 -t 0.05 rest || true
                case "$rest" in
                    "[A"|"OA") (( index = index > 1 ? index - 1 : count )) ;;
                    "[B"|"OB") (( index = index < count ? index + 1 : 1 )) ;;
                    "") return 1 ;;
                esac
                ;;
            k) (( index = index > 1 ? index - 1 : count )) ;;
            j) (( index = index < count ? index + 1 : 1 )) ;;
            $'\n'|$'\r') picked=1 ;;
            q) return 1 ;;
            <1-9>) (( key <= count )) && { index=$key; picked=1 } ;;
        esac
    done
    choice="${options[index]}"
}

# MARK: Service

build_service() {
    "$SERVICE/build.sh"
}

service_loaded() {
    launchctl print "$DOMAIN/$LABEL" &>/dev/null
}

service_pid() {
    launchctl print "$DOMAIN/$LABEL" 2>/dev/null | awk '$1 == "pid" { print $3; exit }'
}

write_plist() {
    mkdir -p "${PLIST:h}" "${LOG:h}"
    cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$SERVICE_EXECUTABLE</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>$LOG</string>
    <key>StandardErrorPath</key>
    <string>$LOG</string>
</dict>
</plist>
PLIST
}

start_service() {
    if service_loaded; then
        print "voiced is already running."
        return 0
    fi
    [[ -x "$SERVICE_EXECUTABLE" ]] || build_service
    write_plist
    # Right after a bootout launchd may still be tearing the job down and refuse the bootstrap
    # with an I/O error for a moment.
    local i
    for i in {1..20}; do
        launchctl bootstrap "$DOMAIN" "$PLIST" 2>/dev/null && break
        sleep 0.25
    done
    if ! service_loaded; then
        print -u2 "voiced did not start; see $LOG"
        return 1
    fi
    print "Started voiced."
}

stop_service() {
    # Removing the plist keeps the service from starting again at the next login.
    rm -f "$PLIST"
    if ! service_loaded; then
        print "voiced is not running."
        return 0
    fi
    launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
    # launchd keeps listing the job for a moment after bootout returns; wait, so a following
    # start loads it again instead of finding it still there.
    local i
    for i in {1..50}; do
        service_loaded || break
        sleep 0.1
    done
    if service_loaded; then
        print -u2 "voiced did not stop."
        return 1
    fi
    print "Stopped voiced."
}

# MARK: Mac app

build_macos() {
    "$ROOT/macos/Scripts/build-app.sh"
}

ui_running() {
    pgrep -f -- "$UI_EXECUTABLE" >/dev/null
}

start_ui() {
    if ui_running; then
        # open brings the running app to the front.
        open "$UI_APP"
        print "Voiced is already running."
        return 0
    fi
    [[ -x "$UI_EXECUTABLE" ]] || build_macos
    open "$UI_APP"
    print "Started Voiced."
}

stop_ui() {
    if ! ui_running; then
        print "Voiced is not running."
        return 0
    fi
    pkill -f -- "$UI_EXECUTABLE"
    # Wait for the process to exit: open run against an app that is still quitting fails with
    # LaunchServices error -600, so restart would leave Voiced stopped.
    local i
    for i in {1..50}; do
        ui_running || break
        sleep 0.1
    done
    if ui_running; then
        print -u2 "Voiced did not stop."
        return 1
    fi
    print "Stopped Voiced."
}

# MARK: iOS

# Prints "<kind>\t<id>\t<label>" for each paired iPhone or iPad (kind device) and each iOS
# simulator worth offering (kind simulator): every booted one, and the iPhones and iPads of the
# newest runtime.
ios_targets() {
    local json="$(mktemp -t voiced-devices)"
    xcrun devicectl list devices --json-output "$json" >/dev/null 2>&1 || true
    xcrun simctl list devices available --json 2>/dev/null | /usr/bin/python3 -c '
import json, re, sys

try:
    devices = json.load(open(sys.argv[1]))["result"]["devices"]
except Exception:
    devices = []
for d in devices:
    hardware = d.get("hardwareProperties", {})
    connection = d.get("connectionProperties", {})
    if hardware.get("deviceType") not in ("iPhone", "iPad") or connection.get("pairingState") != "paired":
        continue
    state = "connected" if connection.get("tunnelState") != "unavailable" and connection.get("tunnelState") != "disconnected" else "not connected"
    # Shown with a plain apostrophe rather than the curly one in the default "Name’s iPhone".
    name = d.get("deviceProperties", {}).get("name", d["identifier"]).replace("’", "\x27")
    print("device", d["identifier"], f"{name} ({state})", sep="\t")

def version(runtime):
    m = re.search(r"iOS-(\d+)-(\d+)", runtime)
    return (int(m.group(1)), int(m.group(2))) if m else None

runtimes = {version(r): v for r, v in json.load(sys.stdin)["devices"].items() if version(r)}
newest = max(runtimes) if runtimes else None
for v in sorted(runtimes, reverse=True):
    for d in runtimes[v]:
        booted = d["state"] == "Booted"
        if booted or (v == newest and d["name"].startswith(("iPhone", "iPad"))):
            note = ", booted" if booted else ""
            name = d["name"]
            print("simulator", d["udid"], f"{name} simulator (iOS {v[0]}.{v[1]}{note})", sep="\t")
' "$json"
    rm -f "$json"
}

# pick_ios_target <title> [running]: asks which iPhone or simulator, and sets target_kind,
# target_id and target_label. With running, only iPhones and booted simulators are offered.
pick_ios_target() {
    local title="$1" only_running="${2:-}"
    local -a kinds ids labels
    local kind id label
    while IFS=$'\t' read -r kind id label; do
        [[ -n "$only_running" && "$kind" == simulator && "$label" != *booted* ]] && continue
        kinds+=("$kind"); ids+=("$id"); labels+=("$label")
    done < <(ios_targets)
    if (( ${#labels} == 0 )); then
        print -u2 "No iPhone or simulator found. Connect an iPhone, or install a simulator in Xcode."
        return 1
    fi
    choose "$title" "${labels[@]}" || return 1
    local i="${labels[(ie)$choice]}"
    target_kind="${kinds[$i]}"
    target_id="${ids[$i]}"
    target_label="${labels[$i]}"
}

# Builds, installs and starts the app on the iPhone or simulator picked, ending the running one
# first; with device, on the paired iPhone without asking.
start_ios() {
    if [[ "${1:-}" == device ]]; then
        "$ROOT/ios/deploy.sh"
        return
    fi
    pick_ios_target "Run Voiced on:" || return 1
    if [[ "$target_kind" == device ]]; then
        "$ROOT/ios/deploy.sh" "$target_id"
    else
        "$ROOT/ios/emulate.sh" "$target_id"
    fi
}

stop_ios() {
    pick_ios_target "Quit Voiced on:" running || return 1
    stop_ios_on "$target_kind" "$target_id" "$target_label"
}

# Quits the app on every connected iPhone and booted simulator, without asking.
stop_ios_everywhere() {
    local kind id label found=0
    while IFS=$'\t' read -r kind id label; do
        [[ "$kind" == simulator && "$label" != *booted* ]] && continue
        [[ "$kind" == device && "$label" == *"(not connected)"* ]] && continue
        found=1
        stop_ios_on "$kind" "$id" "$label" || true
    done < <(ios_targets)
    (( found )) || print "No connected iPhone or booted simulator."
}

# stop_ios_on <kind> <id> <label>: quits the app on that iPhone or simulator.
stop_ios_on() {
    local kind="$1" id="$2" label="$3"
    if [[ "$kind" == simulator ]]; then
        if xcrun simctl terminate "$id" "$IOS_BUNDLE_ID" 2>/dev/null; then
            print "Stopped Voiced on $label."
        else
            print "Voiced is not running on $label."
        fi
        return 0
    fi
    local target_id="$id" target_label="$label"
    local json="$(mktemp -t voiced-processes)" pid
    if ! xcrun devicectl device info processes --device "$target_id" --json-output "$json" >/dev/null 2>&1; then
        rm -f "$json"
        print -u2 "Cannot reach $target_label: connect and unlock it."
        return 1
    fi
    pid="$(/usr/bin/python3 -c '
import json, sys
for p in json.load(open(sys.argv[1])).get("result", {}).get("runningProcesses", []):
    if "/Voiced.app/" in p.get("executable", ""):
        print(p["processIdentifier"]); break
' "$json")"
    rm -f "$json"
    if [[ -z "$pid" ]]; then
        print "Voiced is not running on $target_label."
        return 0
    fi
    xcrun devicectl device process terminate --device "$target_id" --pid "$pid" >/dev/null
    print "Stopped Voiced on $target_label."
}

# MARK: Core

build_core() {
    print "Building core/VoicedCore..."
    (cd "$CORE" && swift build)
}

# MARK: All

build_all() {
    print "==> voiced service"
    build_service
    print "==> macOS"
    build_macos
    print "==> iOS"
    "$ROOT/ios/build.sh" "${1:-simulator}"
}

# The service and the Mac app are started, then the app is built, installed and opened on the
# paired iPhone. A disconnected iPhone is reported and skipped.
start_all() {
    print "==> voiced service"
    start_service
    print "==> Mac app"
    start_ui
    print "==> iPhone"
    "$ROOT/ios/deploy.sh" || print -u2 "Voiced was not started on the iPhone: connect and unlock it, then run voiced start ios device."
}

# The service, the Mac app, and the app on every connected iPhone and booted simulator.
stop_all() {
    print "==> voiced service"
    stop_service
    print "==> Mac app"
    stop_ui
    print "==> iOS"
    stop_ios_everywhere
}

# The service and the Mac app are built and restarted, then the app on the paired iPhone is
# rebuilt, reinstalled and reopened. A disconnected iPhone is reported and skipped.
restart_all() {
    pull
    print "==> voiced service"
    build_service
    stop_service
    start_service
    print "==> Mac app"
    build_macos
    stop_ui
    start_ui
    print "==> iPhone"
    "$ROOT/ios/deploy.sh" || print -u2 "The iPhone was not updated: connect and unlock it, then run voiced restart ios device."
}

# MARK: Pull

# Brings the checkout up to date before a restart builds it: fast-forward only, so it never
# merges. When that cannot be done (offline, no upstream, local changes in the way) the restart
# goes on with the code as it is.
pull() {
    git -C "$ROOT" rev-parse --is-inside-work-tree &>/dev/null || return 0
    print "Pulling..."
    git -C "$ROOT" pull --ff-only || print -u2 "Could not pull; restarting with the code as it is."
}

# MARK: Status

show_status() {
    if service_loaded; then
        local pid="$(service_pid)"
        if [[ -n "$pid" ]]; then
            print "voiced:       running (pid $pid)"
        else
            print "voiced:       starting (launchd will retry; see $LOG)"
        fi
    else
        print "voiced:       stopped"
    fi
    if ui_running; then
        print "Voiced app:   running"
    else
        print "Voiced app:   stopped"
    fi
}

# MARK: Commands

# perform <part> <action> [argument]: does it, or fails with the usage.
perform() {
    local part="$1" action="$2"
    shift 2
    # Only iOS (device, or a device name for deploy) and all (device) take an argument.
    case "$part" in
        ios|all) (( $# <= 1 )) || usage ;;
        *) (( $# == 0 )) || usage ;;
    esac
    case "$part:$action" in
        service:build) build_service ;;
        service:start) start_service ;;
        service:stop) stop_service ;;
        service:restart) pull; build_service; stop_service; start_service ;;
        service:status) show_status ;;
        macos:build) build_macos ;;
        macos:start) start_ui ;;
        macos:stop) stop_ui ;;
        macos:restart) pull; build_macos; stop_ui; start_ui ;;
        ios:build)
            case "${1:-simulator}" in
                sim|simulator) "$ROOT/ios/build.sh" simulator ;;
                device|iphone) "$ROOT/ios/build.sh" device ;;
                *) usage ;;
            esac
            ;;
        # emulate.sh and deploy.sh always build first, and end the running app.
        ios:start|ios:restart)
            [[ -z "${1:-}" || "$1" == device ]] || usage
            if [[ "$action" == restart ]]; then pull; fi
            start_ios "$@"
            ;;
        ios:stop) (( $# == 0 )) || usage; stop_ios ;;
        ios:deploy) "$ROOT/ios/deploy.sh" "$@" ;;
        core:build) build_core ;;
        all:build)
            case "${1:-simulator}" in
                sim|simulator) build_all simulator ;;
                device|iphone) build_all device ;;
                *) usage ;;
            esac
            ;;
        all:restart) [[ -z "${1:-}" || "$1" == device ]] || usage; restart_all ;;
        all:start) (( $# == 0 )) || usage; start_all ;;
        all:stop) (( $# == 0 )) || usage; stop_all ;;
        *)
            print -u2 "voiced: $part has no $action."
            usage
            ;;
    esac
}

actions_of() {
    case "$1" in
        service) reply=(build start stop restart status) ;;
        macos) reply=(build start stop restart) ;;
        ios) reply=(build restart start stop) ;;
        core) reply=(build) ;;
    esac
}

parts_for() {
    case "$1" in
        build) reply=(all core service ios macos) ;;
        restart) reply=(all service ios macos) ;;
        start|stop) reply=(all service macos ios) ;;
    esac
}

typeset -a reply
choice=""

case "${1:-}" in
    ""|help|-h|--help)
        show_help
        ;;
    status)
        (( $# == 1 )) || usage
        show_status
        ;;
    service|macos|ios|core)
        part="$1"
        shift
        if (( $# == 0 )); then
            actions_of "$part"
            choose "$part:" "${reply[@]}" || exit 1
            set -- "$choice"
        fi
        action="$1"
        shift
        perform "$part" "$action" "$@"
        ;;
    build|start|stop|restart)
        action="$1"
        shift
        if (( $# == 0 )); then
            parts_for "$action"
            choose "$action:" "${reply[@]}" || exit 1
            set -- "$choice"
        fi
        part="$1"
        shift
        perform "$part" "$action" "$@"
        ;;
    *)
        usage
        ;;
esac
